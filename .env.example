# Copy this file to .env at the repository root. Never commit .env.
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# Override these host ports too if local PostgreSQL or Redis already uses them.
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://gitfolio:gitfolio@localhost:5432/gitfolio_dev
REDIS_URL=redis://localhost:6379

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100

# Phase 2: optional until authentication is implemented.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_CALLBACK_URL=http://localhost:5173/auth/callback
JWT_SECRET=
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=

