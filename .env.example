# Copy this file to .env at the repository root. Never commit .env.
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# Override these host ports too if local PostgreSQL or Redis already uses them.
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://gitfolio:gitfolio@localhost:5432/gitfolio_dev
REDIS_URL=redis://localhost:6379

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100

# GitHub OAuth App: register using docs/GITHUB_OAUTH_SETUP.md.
# Keep these server-side; never prefix them with VITE_.
# Leave empty to run health checks without enabling sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/auth/callback

# Run npm run auth:setup to create local secrets without printing them.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Recommended: 64 hex characters encoding 32 random bytes. Legacy 32-byte UTF-8 keys are also supported.
ENCRYPTION_KEY=

